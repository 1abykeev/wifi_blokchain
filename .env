# -------------------------------------------------------
#  WiFi Blockchain — environment configuration
# -------------------------------------------------------

# Set to True to run without a real WiFi adapter (VirtualBox / CI / demo).
# In simulation mode the Scapy sniffer is skipped entirely.
# Devices connect and messages are sent through the Flask API only.
# The blockchain still records every event normally.
SIMULATION_MODE=True

# Network interface for REAL mode (ignored when SIMULATION_MODE=True).
# Must be in monitor mode: sudo ip link set wlan0 down
#                           sudo iw dev wlan0 set type monitor
#                           sudo ip link set wlan0 up
WIFI_INTERFACE=wlan0

# Flask settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# Mine a new block automatically after every transaction (True) or
# accumulate pending transactions and mine manually (False).
AUTO_MINE=True
