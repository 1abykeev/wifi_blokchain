# -------------------------------------------------------
#  WiFi Blockchain — environment configuration
#  Copy to .env and edit before running.
# -------------------------------------------------------

# SIMULATION_MODE=True  → no real WiFi adapter needed.
#   The Scapy sniffer is skipped entirely.
#   Devices connect and messages are sent through the Flask API only.
#   The blockchain still records every event normally.
SIMULATION_MODE=True

# Network interface for REAL mode (ignored when SIMULATION_MODE=True).
# Must be in AP mode for setup_ap.sh; monitor mode for raw Scapy sniffing.
WIFI_INTERFACE=wlan0

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=change-me-in-production

# Mine a new block immediately after every transaction (True) or
# accumulate pending transactions and mine manually (False).
AUTO_MINE=True

# Access-point settings (used by scripts/setup_ap.sh)
AP_SSID=WiFi-Blockchain
AP_PASSPHRASE=blockchain123
AP_CHANNEL=6
AP_IP=192.168.99.1
DHCP_RANGE=192.168.99.10,192.168.99.50,12h
UPSTREAM_IFACE=eth0
